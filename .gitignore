.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this should be ignored:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different platforms or python versions,
#   Pipfile.lock might be changed, and the subsequent git pull will override local changes.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended, but can be ignored due to shared platform issues.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended, but can be ignored due to shared platform issues.
# pdm.lock

# virtualenv
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

